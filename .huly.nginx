# Sólo manda "Connection: upgrade" cuando el pedido es de verdad un WebSocket.
# Con el valor fijo "upgrade", los POST normales al transactor (por ejemplo
# /api/v1/ensure-person) llegaban como si fueran un handshake y el servidor los rechazaba con 400.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# El bloque que sirve HTML, JS y CSS hablaba HTTP/1.0 con "Connection: close": cada asset abria
# y cerraba una conexion TCP nueva contra el front. El front ya anuncia keep-alive (5 s, 1000
# pedidos); este upstream es lo que hace falta para aprovecharlo.
upstream front_up {
    server front:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 100M;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml application/wasm;

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # keepalive exige HTTP/1.1 y que no se reenvie la cabecera Connection del cliente.
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_pass http://front_up;
    }

    location /_accounts {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        rewrite ^/_accounts(/.*)$ $1 break;
        proxy_pass http://account:3000/;
    }

